# =======================
# Next.js Development Dockerfile
# =======================
FROM node:20-alpine

# Disable Next.js telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Enable hot reload in Docker
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true

WORKDIR /usr/src/app

# Copy package files first for faster rebuilds
COPY package*.json ./

# Install dependencies with legacy-peer-deps to avoid conflicts
RUN npm install -f

# Copy the full source code
COPY . .

# Make sure `.next` is writable
RUN mkdir -p .next && chmod -R 777 .next

# Install TypeScript tools safely
RUN npm install -D typescript ts-node --legacy-peer-deps

# Expose development port
EXPOSE 3000

# Start Next.js in dev mode
CMD ["npm", "run", "dev"]
